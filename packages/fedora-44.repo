# Fedora 44, not the rolling Rawhide. Hummingbird pins its rawhide variant to
# Fedora 44 (images/variables.yml, default_variant_repos.rawhide), and F44
# carries OpenSSL 3.5.5 -- libcrypto.so.3, the ABI the Hummingbird base has.
# Rawhide is three releases ahead on OpenSSL 4 and its packages cannot be
# installed here at all.
#
# gpgkey names the Fedora 44 key specifically rather than the combined
# https://fedoraproject.org/fedora.gpg bundle. That bundle carries every live
# Fedora key, and importing it into this image's rpmdb fails partway: the 45,
# 46 and 44 keys import, the 43 key does not, and dnf5 then treats the whole
# keyring as failed and rejects every Fedora 44 package --
#   Transaction failed: Signature verification failed.
#   OpenPGP check for package "adw-gtk3-theme-6.4-3.fc44.noarch" ... has failed
# after a clean 949-package download. One key, whose fingerprint
# 36F612DC F27F7D1A 48A835E4 DBFCF71C 6D9F90A6 matches the Fedora (44) primary
# key the failing transaction asked for, imports without incident.
[fedora-44]
name=Fedora 44 - $basearch
baseurl=https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Everything/$basearch/os/
enabled=1
metadata_expire=6h
repo_gpgcheck=0
type=rpm
gpgcheck=1
gpgkey=https://src.fedoraproject.org/rpms/fedora-repos/raw/rawhide/f/RPM-GPG-KEY-fedora-44-primary
skip_if_unavailable=False

[fedora-44-updates]
name=Fedora 44 - $basearch - Updates
baseurl=https://dl.fedoraproject.org/pub/fedora/linux/updates/44/Everything/$basearch/
enabled=1
metadata_expire=6h
repo_gpgcheck=0
type=rpm
gpgcheck=1
gpgkey=https://src.fedoraproject.org/rpms/fedora-repos/raw/rawhide/f/RPM-GPG-KEY-fedora-44-primary
skip_if_unavailable=False
